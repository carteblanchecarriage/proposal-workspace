{
  "framework": "vite",
  "functions": {
    "api/auth.ts": {
      "maxDuration": 300
    },
    "api/chat.ts": {
      "maxDuration": 300
    },
    "api/compare.ts": {
      "maxDuration": 300
    },
    "api/db.ts": {
      "maxDuration": 300
    },
    "api/extract.ts": {
      "maxDuration": 300
    },
    "api/fee-draft.ts": {
      "maxDuration": 300
    },
    "api/feedback.ts": {
      "maxDuration": 300
    },
    "api/rfp.ts": {
      "maxDuration": 300
    },
    "api/schedule-ai.ts": {
      "maxDuration": 300
    },
    "api/schedule-pdf.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/upload.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ],
  "cleanUrls": true
}
