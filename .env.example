# Copy to .env.local and fill in. Never commit .env.local.

# Required: Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API Keys). Without these, saving falls back to the browser and there's no login.
SUPABASE_URL=
# Secret key (sb_secret_...): server only, reads and writes the tables.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...): turns on login. Safe for the browser; it only reaches Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=

# Required with Supabase: encrypts saved records (32 random bytes, base64). Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME key locally and on Vercel, and keep a copy in a password manager: without it the data can't be read.
DATA_ENCRYPTION_KEY=

# Optional: only these people get in (comma-separated emails and/or @domain.com). Leave empty for open sign-up.
AUTH_ALLOWED_EMAILS=
# Emails that may open the site owner's activity page (#admin), comma-separated.
ADMIN_EMAILS=

# Monthly AI spending limit (US$) for each NEW organization. 0 = no AI until it subscribes (or you raise it by hand).
DEFAULT_ORG_AI_LIMIT_USD=0

# Sign-ups are invite-only unless this is 1.
OPEN_SIGNUPS=

# Billing (Stripe). One plan: a monthly subscription that turns on AI with a cap per billing period.
# Webhook endpoint in Stripe: https://<your site>/api/auth, sending customer.subscription.* and checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# AI included per billing period, in US$ (default 40)
PLAN_AI_CAP_USD=40
# Set to 1 once Stripe Tax is set up, to collect sales tax at checkout
STRIPE_TAX=
