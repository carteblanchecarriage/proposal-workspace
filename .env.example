# Copy to .env.local and fill in. Never commit .env.local.

# Required: Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API Keys). Without these, saving falls back to the browser and there's no login.
SUPABASE_URL=
# Secret key (sb_secret_...): server only, reads and writes the tables.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...): turns on login. Safe for the browser; it only reaches Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=

# Required with Supabase: encrypts saved records (32 random bytes, base64). Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME key locally and on Vercel, and keep a copy in a password manager: without it the data can't be read.
DATA_ENCRYPTION_KEY=

# Optional: only these people get in (comma-separated emails and/or @domain.com). Leave empty for open sign-up.
AUTH_ALLOWED_EMAILS=

# Monthly AI spending limit (US$) for each NEW organization. 0 = no AI until you raise it in the organizations table.
DEFAULT_ORG_AI_LIMIT_USD=0
